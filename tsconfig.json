{
  "compilerOptions": {
    // Language and JSX runtime.
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    // Module resolution and source aliases.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },

    // Import and module behavior.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    // Type safety and dependency checking.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Type-check only; Vite handles build output.
    "noEmit": true
  },

  // Application source and Vite configuration.
  "include": ["**/*.ts", "**/*.tsx", "vite.config.ts"]
}
